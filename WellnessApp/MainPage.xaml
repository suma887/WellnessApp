<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutismSupportApp.MainPage"
             BackgroundImageSource="soft_bg.jpg"
             Title="Daily Activity Tracker">

    <!-- Use a Grid to position button at bottom -->
    <Grid RowDefinitions="Auto,* ,Auto"
          Padding="20"
          RowSpacing="15">

        <!-- Scrollable Main Content -->
        <ScrollView Grid.Row="1">
            <StackLayout Spacing="15">

                <!-- Title -->
                <Label Text="Daily Activity Tracker"
                       FontAttributes="Bold"
                       FontSize="28"
                       HorizontalOptions="Center"
                       TextColor="#1e3a8a" />

                <!-- Child Info Section -->
                <Frame BackgroundColor="#ffffffcc"
                       BorderColor="#cbd5e1"
                       CornerRadius="12"
                       Padding="15">
                    <StackLayout Spacing="10">
                        <Label Text="Child Information"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1e293b"/>

                        <Entry x:Name="ChildNameEntry"
                               Placeholder="Enter child’s name"
                               FontSize="16"
                               TextColor="#1e293b"/>

                        <DatePicker x:Name="DatePicker"
                                    Format="D"
                                    TextColor="#1e293b" />
                    </StackLayout>
                </Frame>

                <!-- Mood Tracker -->
                <Frame BackgroundColor="#ffffffcc"
                       BorderColor="#cbd5e1"
                       CornerRadius="12"
                       Padding="15">
                    <StackLayout Spacing="10">
                        <Label Text="Mood Level"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1e293b"/>

                        <Label x:Name="MoodLabel" Text="Happy 😊"
                               FontSize="16"
                               HorizontalOptions="Center"/>

                        <Slider x:Name="MoodSlider"
                                Minimum="0" Maximum="4" Value="2"
                                MinimumTrackColor="#60a5fa"
                                ThumbColor="#2563eb"
                                ValueChanged="MoodSlider_ValueChanged"/>

                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20">
                            <Label Text="Sad 😞"/>
                            <Label Text="Calm 😌"/>
                            <Label Text="Happy 😊"/>
                            <Label Text="Excited 🤩"/>
                            <Label Text="Overstimulated 😣"/>
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- Focus Level -->
                <Frame BackgroundColor="#ffffffcc"
                       BorderColor="#cbd5e1"
                       CornerRadius="12"
                       Padding="15">
                    <StackLayout Spacing="10">
                        <Label Text="Focus Level (1–10)"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1e293b"/>
                        <Label x:Name="FocusLabel" Text="5" HorizontalOptions="End" />
                        <Slider x:Name="FocusSlider"
                                Minimum="1" Maximum="10" Value="5"
                                MinimumTrackColor="#60a5fa"
                                ThumbColor="#2563eb"
                                ValueChanged="Slider_ValueChanged"/>
                    </StackLayout>
                </Frame>

                <!-- Communication Activity -->
                <Frame BackgroundColor="#ffffffcc"
                       BorderColor="#cbd5e1"
                       CornerRadius="12"
                       Padding="15">
                    <StackLayout Spacing="10">
                        <Label Text="Communication Type"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1e293b"/>
                        <Picker x:Name="CommunicationPicker"
                                Title="Select interaction type">
                            <Picker.Items>
                                <x:String>Spoke clearly</x:String>
                                <x:String>Used gestures</x:String>
                                <x:String>Limited response</x:String>
                                <x:String>No communication</x:String>
                            </Picker.Items>
                        </Picker>
                    </StackLayout>
                </Frame>

                <!-- Activity Duration -->
                <Frame BackgroundColor="#ffffffcc"
                       BorderColor="#cbd5e1"
                       CornerRadius="12"
                       Padding="15">
                    <StackLayout Spacing="10">
                        <Label Text="Activity Duration"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1e293b"/>
                        <Label x:Name="ActivityLabel" Text="30 min" HorizontalOptions="End"/>
                        <Slider x:Name="ActivitySlider"
                                Minimum="0" Maximum="180" Value="30"
                                MinimumTrackColor="#60a5fa"
                                ThumbColor="#2563eb"
                                ValueChanged="Slider_ValueChanged"/>
                    </StackLayout>
                </Frame>

                <!-- Notes Section -->
                <Frame BackgroundColor="#ffffffcc"
                       BorderColor="#cbd5e1"
                       CornerRadius="12"
                       Padding="15">
                    <StackLayout Spacing="10">
                        <Label Text="Mentor Notes"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1e293b"/>
                        <Editor x:Name="NotesEditor"
                                Placeholder="Enter observations, behavior notes, or triggers..."
                                AutoSize="TextChanges"
                                FontSize="16"
                                TextColor="#1e293b"/>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Bottom-aligned Button -->
        <Button Grid.Row="2"
                Text="Save Daily Report"
                BackgroundColor="#2563eb"
                TextColor="White"
                FontSize="18"
                WidthRequest="220"
                HeightRequest="45"
                CornerRadius="25"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,10,0,20"
                Clicked="SaveButton_Clicked" />
    </Grid>
</ContentPage>
